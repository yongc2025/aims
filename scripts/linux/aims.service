[Unit]
Description=AIMS - AI Market Intelligence System
Documentation=https://github.com/your-repo/aims
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/aims

# Environment
Environment=AIMS_LOG_FILE=/opt/aims/logs/aims.log
Environment=LLM_PROVIDER=opencode
Environment=OPENCODE_BASE_URL=https://api.deepseek.com/v1
Environment=OPENCODE_API_KEY=<YOUR_API_KEY>
Environment=OPENCODE_MODEL=deepseek-v4-flash
Environment=DATABASE_URL=sqlite:///storage/aims.db
Environment=API_HOST=127.0.0.1
Environment=API_PORT=18765

# Clear proxy for Chinese financial APIs
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
Environment=http_proxy=
Environment=https_proxy=
Environment=all_proxy=

# ──────────────────────────────────────────────
# Python executable — choose ONE of the options:
# ──────────────────────────────────────────────

# Option A: conda environment (recommended — you have py3127)
# Find your conda env path with: conda run -n py3127 which python
# Typically: /home/ubuntu/miniconda3/envs/py3127/bin/python
ExecStart=/home/ubuntu/miniconda3/envs/py3127/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 18765

# Option B: .venv (venv / virtualenv)
# ExecStart=/opt/aims/.venv/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port 18765

ExecReload=/bin/kill -HUP $MAINPID

# Logging
StandardOutput=append:/opt/aims/logs/aims.stdout.log
StandardError=append:/opt/aims/logs/aims.stderr.log

# Restart policy
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
